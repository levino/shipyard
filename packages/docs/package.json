{
  "name": "@levino/shipyard-docs",
  "version": "0.9.1",
  "description": "Documentation plugin for shipyard with automatic sidebar, pagination, and git metadata",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test:unit": "vitest run"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "frameworks",
    "documentation",
    "docs",
    "sidebar",
    "markdown"
  ],
  "author": "Levin Keller",
  "license": "MIT",
  "homepage": "https://shipyard.levinkeller.de",
  "peerDependencies": {
    "astro": "^7.2.4"
  },
  "dependencies": {
    "effect": "^3.22.1",
    "ramda": "^0.32.0",
    "unist-util-visit": "^5.0.0",
    "@levino/shipyard-base": "^0.9.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "@types/ramda": "^0.32",
    "astro": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "repository": {
