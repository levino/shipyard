{
  "scripts": {
    "setup": "npm install && npm exec @lavamoat/allow-scripts",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "type-check": "tsc --noEmit && npm run type-check --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "lefthook": "^2.1.15",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/demos/*",
    "apps/test/*"
  ],
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "lefthook#2.1.14": true
    }
  }
}
