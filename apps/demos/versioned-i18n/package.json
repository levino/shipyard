{
  "name": "versioned-i18n-demo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "git fetch --unshallow || true && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@levino/shipyard-base": "*",
    "@levino/shipyard-docs": "*",
    "@tailwindcss/vite": "^4",
    "astro": "^7.3.6",
    "daisyui": "^5.7.47",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20"
  }
}
